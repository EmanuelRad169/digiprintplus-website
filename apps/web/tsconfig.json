{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": "./src",
    "paths": {
      "@/*": [
        "*"
      ],
      "@/components/*": [
        "components/*"
      ],
      "@/lib/*": [
        "lib/*"
      ],
      "@/types/*": [
        "types/*"
      ],
      "@/hooks/*": [
        "hooks/*"
      ],
      "@/app/*": [
        "app/*"
      ],
      "@/utils/*": [
        "lib/utils/*",
        "utils/*"
      ],
      "@workspace/ui": [
        "../../packages/ui"
      ],
      "@workspace/ui/*": [
        "../../packages/ui/*"
      ],
      "@workspace/utils": [
        "../../packages/utils/src"
      ],
      "@workspace/hooks": [
        "../../packages/hooks/src"
      ],
      "@workspace/types": [
        "../../packages/types/src"
      ]
    },
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "5.0"
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "lib",
    "hooks",
    "pages",
    "stories",
    "__tests__"
  ],
  "references": [
    {
      "path": "../../packages/ui"
    },
    {
      "path": "../../packages/utils"
    },
    {
      "path": "../../packages/hooks"
    },
    {
      "path": "../../packages/types"
    }
  ]
}
