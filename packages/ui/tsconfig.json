{
  "extends": "../config/typescript/react.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": ".",
    "ignoreDeprecations": "5.0",
    "paths": {
      "@/components/*": [
        "./*"
      ],
      "@/lib/utils": [
        "../utils/src/utils.ts"
      ],
      "@workspace/utils": [
        "../utils/src"
      ],
      "@workspace/utils/*": [
        "../utils/*"
      ],
      "@workspace/types": [
        "../types/src"
      ],
      "@workspace/types/*": [
        "../types/src/*"
      ]
    }
  },
  "include": [
    "index.ts",
    "ui/alert-dialog.tsx",
    "ui/aspect-ratio.tsx",
    "ui/button.tsx",
    "ui/card.tsx",
    "ui/error-boundary.tsx",
    "ui/input.tsx",
    "ui/pagination.tsx",
    "ui/popover.tsx",
    "ui/progress.tsx",
    "ui/slider.tsx",
    "ui/tabs.tsx",
    "ui/textarea.tsx",
    "ui/toast.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "references": [
    {
      "path": "../utils"
    },
    {
      "path": "../types"
    }
  ]
}
